# Copy to .env (gitignored) in the repo root. Read by the workstation server only; never sent to the browser.

# Agents use the scripted runtime unless this is set.
OPENAI_API_KEY=
# Every agent uses gpt-6-luna; there is no model setting.
# Fallback only when OpenAI cannot answer: Claude Sonnet 5.5 through Nous Research (prepaid credit).
NOUS_API_KEY=
# Total tokens the agents may use per day (UTC). When reached, agents fall back to the scripted runtime.
OPENAI_DAILY_TOKEN_LIMIT=10000000
# Safety nets, not rations (one agent call is about 3-4k tokens). Per-space and per-person daily
# allowances, and how often one person may ask agents per minute.
AGENT_SPACE_DAILY_TOKENS=3000000
AGENT_PERSON_DAILY_TOKENS=1000000
AGENT_REQUESTS_PER_MINUTE=20
# Set to "scripted" to force the scripted runtime even when a key is present.
AGENT_RUNTIME=

# Server
# Google sign-in: an OAuth Web client ID. When set, people continue with Google instead of typing a name.
GOOGLE_CLIENT_ID=
# Linking Google Sheets: the same OAuth client's secret (Sheets API on, redirect /api/connect/google/callback).
GOOGLE_CLIENT_SECRET=
# Linking Excel in OneDrive/SharePoint: a Microsoft Entra app (redirect /api/connect/microsoft/callback).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The address people use, when it differs from what the server sees.
PUBLIC_URL=
# The shared browser service (browser-service/): ws://<host>:<port>/<BROWSER_TOKEN>. Unset, Browser pages are off.
BROWSER_SERVICE_URL=
PORT=4174
# 127.0.0.1 = this machine only. 0.0.0.0 = others on your network can join (demo sign-in, trusted networks only).
HOST=127.0.0.1
