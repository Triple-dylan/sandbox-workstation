# Copy to .env (gitignored) in the repo root. Read by the workstation server only; never sent to the browser.

# Required for live agent replies. Without a key, the app reports Model unavailable.
OPENAI_API_KEY=
# All agents use gpt-6-luna. Model overrides are not supported.
# Total tokens the agents may use per day (UTC). Requests stop with an explicit error at the limit.
OPENAI_DAILY_TOKEN_LIMIT=200000
# Only for deterministic development fixtures: set to "scripted". Live is the default.
AGENT_RUNTIME=

# Server
PORT=4174
# 127.0.0.1 = this machine only. 0.0.0.0 = others on your network can join (demo sign-in, trusted networks only).
HOST=127.0.0.1

# Google Web OAuth client ID (public). Configuring this disables local profile login.
GOOGLE_CLIENT_ID=
# Exact app origin; HTTPS required for production.
APP_ORIGIN=
