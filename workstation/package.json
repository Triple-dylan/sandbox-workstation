{
  "name": "sandbox-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node --disable-warning=ExperimentalWarning server/index.ts",
    "serve": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test tests/e2e/*.test.ts",
    "format": "prettier --write src server shared tests evals scripts vite.config.ts",
    "format:check": "prettier --check src server shared tests evals scripts vite.config.ts",
    "build:inpage": "vite build -c inpage/vite.config.ts && node inpage/assemble.mjs",
    "eval": "node --disable-warning=ExperimentalWarning evals/run.ts",
    "db:copy": "node --disable-warning=ExperimentalWarning scripts/db-copy.ts",
    "restore": "node --disable-warning=ExperimentalWarning server/restore.ts",
    "lint": "oxlint --deny-warnings src"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tiptap/extension-collaboration": "2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "d3-force": "3.0.0",
    "fflate": "^0.8.2",
    "google-auth-library": "^10.9.1",
    "lucide-react": "1.63.0",
    "pg": "^8.23.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tiptap-markdown": "^0.8.10",
    "y-prosemirror": "1.3.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.95.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sql.js": "^1.13.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
