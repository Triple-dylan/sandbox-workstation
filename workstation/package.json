{
  "name": "sandbox-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node --disable-warning=ExperimentalWarning server/index.ts",
    "serve": "node --disable-warning=ExperimentalWarning server/index.ts",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test tests/e2e/*.test.ts",
    "format": "prettier --write src server shared tests scripts vite.config.ts",
    "format:check": "prettier --check src server shared tests scripts vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "d3-force": "3.0.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/d3-force": "3.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
